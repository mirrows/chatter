{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chatters",
  "version": "1.0.0-rc.2",
  "identifier": "com.chatters.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Chatters",
        "width": 960,
        "height": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/**", "$APPDATA/**", "$DOWNLOAD/**", "$PICTURE/**", "$DESKTOP/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "nsis/installer-hooks.nsh"
      }
    },
    "android": {
      "minSdkVersion": 24
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/mirrows/chatter/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFDN0ZEODNDRkRGNUE4Q0IKUldUTHFQWDlQTmgvSE1Uc2JTQ2NVaUdMQitHR283MmluaGVzcFc0N1NTQVpIZXdNVDBibit1OFUK"
    }
  }
}
